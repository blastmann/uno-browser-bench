{
  "manifest_version": 3,
  "name": "Browser Intent Preview (local)",
  "version": "0.1.0",
  "description": "Predicts a coarse browser intent locally from redacted observation traces.",
  "permissions": ["history", "tabs", "storage", "webNavigation", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Browser Intent Preview"
  },
  "options_page": "options.html"
}
